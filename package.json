{
  "name": "crypto-lab-ring-sign",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run test:maintenance && npm run test:publish-request && tsc --noEmit && vite build",
    "preview": "vite preview",
    "deploy": "gh workflow run pages.yml --repo systemslibrarian/crypto-lab-ring-sign --ref main",
    "test": "vitest run",
    "test:a11y": "playwright test --project=a11y",
    "test:claims": "playwright test --project=claims",
    "test:e2e:all": "playwright test",
    "test:maintenance": "node --test tests/maintenance-controls.node.mjs",
    "test:publish-request": "node --test tests/publish-request.node.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.64.0",
    "typescript": "~7.0.2",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "dependencies": {
    "@noble/curves": "^2.4.0"
  }
}
